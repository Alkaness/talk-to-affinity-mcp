{
  "name": "@alkaness/talk-to-affinity-mcp",
  "version": "0.1.0",
  "description": "MCP server for Affinity by Canva: typed, token-efficient tools over Affinity's native local MCP endpoint.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "affinity",
    "affinity-by-canva",
    "canva",
    "design"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "talk-to-affinity-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alkaness/talk-to-affinity-mcp.git"
  },
  "homepage": "https://github.com/Alkaness/talk-to-affinity-mcp#readme",
  "bugs": {
    "url": "https://github.com/Alkaness/talk-to-affinity-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc && node -e \"require('fs').copyFileSync('src/sdk.js', 'dist/src/sdk.js')\"",
    "prepack": "npm run build",
    "test": "npm run build && node --test --test-force-exit \"dist/test/**/*.test.js\"",
    "test:live": "npm run build && AFFINITY_LIVE=1 node --test --test-force-exit --test-concurrency=1 \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "typescript": "7.0.2"
  }
}
